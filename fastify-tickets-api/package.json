{
  "name": "fastify-tickets-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node --env-file=.env dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "db:reset": "tsx --env-file=.env src/db/reset.ts && npm run db:seed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p load-tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "bash load-tests/run-benchmarks.sh",
    "bench:report": "tsx scripts/bench-report.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/k6": "^2.3.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.7",
    "@fastify/sensible": "^6.0.7",
    "@fastify/type-provider-typebox": "^6.3.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "typebox": "^1.4.3"
  }
}
