{
  "compilerOptions": {
    "rootDirs": ["src", "generated"],
    "outDir": "dist",
    "lib": ["es2023"],
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "generated"]
}